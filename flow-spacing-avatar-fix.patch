+package io.github.aedev.flow.ui.components.videoplayer.ambient
+
+import androidx.compose.animation.animateColorAsState
+import androidx.compose.animation.core.tween
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.ImageBitmap
+import androidx.compose.ui.graphics.asAndroidBitmap
+import androidx.compose.ui.graphics.lerp
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.withContext
+
+/**
+ * The average colour of the latest ambient frame, shared with the player's info panels.
+ *
+ * The frame is produced by [rememberAmbientFrame] inside the player surface, while the comments
+ * card and action buttons live in another part of the tree, so the colour is published here.
+ * Null means no ambient frame yet (or ambient is off), and panels fall back to their theme colour.
+ */
+object AmbientTint {
+    private val state = MutableStateFlow<Color?>(null)
+    val color: StateFlow<Color?> = state.asStateFlow()
+
+    fun publish(color: Color?) {
+        state.value = color
+    }
+}
+
+/** Average of a coarse grid of pixels, so it stays cheap at ambient frame rate. */
+suspend fun ImageBitmap.ambientAverageColor(): Color? =
+    withContext(Dispatchers.Default) {
+        val bitmap = asAndroidBitmap()
+        val width = bitmap.width
+        val height = bitmap.height
+        if (width <= 0 || height <= 0) return@withContext null
+        val stepX = maxOf(1, width / 16)
+        val stepY = maxOf(1, height / 16)
+        var r = 0L
+        var g = 0L
+        var b = 0L
+        var n = 0L
+        var y = 0
+        while (y < height) {
+            var x = 0
+            while (x < width) {
+                val p = bitmap.getPixel(x, y)
+                r += (p shr 16) and 0xFF
+                g += (p shr 8) and 0xFF
+                b += p and 0xFF
+                n++
+                x += stepX
+            }
+            y += stepY
+        }
+        if (n == 0L) return@withContext null
+        Color(
+            red = (r / n) / 255f,
+            green = (g / n) / 255f,
+            blue = (b / n) / 255f,
+        )
+    }
+
+/**
+ * [base] mixed toward the ambient colour by [amount], animated so the panel shifts smoothly as the
+ * video changes. Returns [base] unchanged while no ambient colour is available.
+ */
+@Composable
+fun ambientTinted(base: Color, amount: Float = 0.35f): Color {
+    val ambient by AmbientTint.color.collectAsState()
+    val target = ambient?.let { lerp(base, it, amount) } ?: base
+    return animateColorAsState(targetValue = target, animationSpec = tween(durationMillis = 600)).value
+}
