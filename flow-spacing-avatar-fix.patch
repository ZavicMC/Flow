+/**
+ * The sheet drag handle at YouTube's spacing: 8 dp above and below a 32 x 4 dp bar.
+ *
+ * Not `BottomSheetDefaults.DragHandle`: it applies its own 22 dp vertical padding inside, on top of
+ * whatever modifier it is given, so no caller can tighten it. That is the 48 dp strip between the
+ * player and the sheet title.
+ */
+@Composable
+internal fun FlowSheetDragHandle(modifier: Modifier = Modifier) {
+    Box(
+        modifier =
+            modifier
+                .padding(vertical = 8.dp)
+                .size(width = 32.dp, height = 4.dp)
+                .clip(CircleShape)
+                .background(MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.4f)),
+    )
+}
