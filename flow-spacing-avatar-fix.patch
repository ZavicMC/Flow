+package io.github.aedev.flow.ui.components.shared
+
+import android.graphics.Color as AndroidColor
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.toArgb
+import kotlin.math.roundToInt
+
+/**
+ * Approximates the "Tekstur" gallery filter on the description sheet's cards.
+ *
+ * Measured on four artwork pairs, the filter lowers brightness to about 50–75% and saturation to
+ * about 77–92%. The filter's own curves are proprietary (.videofx), so this is a fitted
+ * approximation: value x [VALUE_GAIN], saturation x [SATURATION_GAIN], hue unchanged.
+ *
+ * Only the card containers are changed. Text and link colours stay as they were, so the copy
+ * keeps its contrast.
+ */
+internal const val VALUE_GAIN = 0.6f
+internal const val SATURATION_GAIN = 0.85f
+
+internal fun Color.textured(): Color {
+    val hsv = FloatArray(3)
+    AndroidColor.colorToHSV(this.toArgb(), hsv)
+    hsv[1] = (hsv[1] * SATURATION_GAIN).coerceIn(0f, 1f)
+    hsv[2] = (hsv[2] * VALUE_GAIN).coerceIn(0f, 1f)
+    val alphaInt = (alpha * 255f).roundToInt().coerceIn(0, 255)
+    val argb = AndroidColor.HSVToColor(alphaInt, hsv)
+    return Color(argb)
+}
+
+/** Description-sheet tint with the texture approximation applied to the card containers only. */
+internal fun MediaArtworkTint.texturedForDescription(): MediaArtworkTint =
+    copy(
+        container = container.textured(),
+        raised = raised.textured(),
+    )
