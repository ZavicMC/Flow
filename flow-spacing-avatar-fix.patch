+/**
+ * Geometry and timing from the reference recording (51 fps).
+ *
+ * Source values are in video pixels. [PX_PER_DP] converts them to dp; 3 px per dp matches a
+ * 1080-wide phone. Widths are kept as plain Floats (dp) so the spring maths runs without rounding.
+ */
+internal object PlaybackSpec {
+    const val PX_PER_DP = 3f
+
+    private fun px(v: Float) = v / PX_PER_DP
+
+    // Side (Previous / Next) buttons: 169 x 136 px, squircle.
+    val SideWidth: Dp = px(169f).dp
+    val SideHeight: Dp = px(136f).dp
+    val SideCorner: Dp = 24.dp
+    val Gap: Dp = 16.dp
+
+    // Centre pill: 270 x 135 px at rest.
+    val HeightDp: Dp = px(135f).dp
+    val RestWidth = px(270f) // Phase 4 settles here
+    val PeakWidth = px(300f) // Phase 1 peak
+    val UndershootWidth = px(266f) // Phase 3 undershoot
+    val PressWidth = px(244f) // Press compression
+    val ReleaseWidth = px(274f) // Spring-out target after release
+
+    // Phase timings (ms).
+    const val EXPAND_MS = 117
+    const val HOLD_MS = 117
+    const val RECOIL_MS = 136 // 234 ms -> 370 ms
+    const val PRESS_MS = 156
+
+    // Easing curves.
+    val StiffSnap: Easing = CubicBezierEasing(0.2f, 0f, 0f, 1f)
+    val PressEase: Easing = CubicBezierEasing(0.4f, 0f, 0.2f, 1f)
+    // Not given in the spec for the recoil leg; this is a standard ease-in-out.
+    val RecoilEase: Easing = CubicBezierEasing(0.4f, 0f, 0.6f, 1f)
+
+    // Springs.
+    val SettleSpring = spring<Float>(dampingRatio = 0.68f, stiffness = 380f)
+    val ReboundSpring = spring<Float>(dampingRatio = 0.75f, stiffness = 450f)
+}
+
+/**
+ * Previous, Play/Pause and Next.
+ *
+ * [trackKey] is any value that changes with the track. A change plays the same stretch as a
+ * Previous/Next tap. [onPlayPauseChange] receives the new playing state after the release.
+ */
+@Composable
+fun MusicPlaybackControls(
+    isPlaying: Boolean,
+    onPrevious: () -> Unit,
+    onNext: () -> Unit,
+    onPlayPauseChange: (Boolean) -> Unit,
+    modifier: Modifier = Modifier,
+    trackKey: Any? = null,
+    onLongPressPrevious: (() -> Unit)? = null,
+    onLongPressNext: (() -> Unit)? = null,
+    onLongPressEnd: (() -> Unit)? = null,
+) {
+    val scope = rememberCoroutineScope()
+    val width = remember { Animatable(PlaybackSpec.RestWidth) }
+    var playing by remember(isPlaying) { mutableStateOf(isPlaying) }
+    var skipCount by remember { mutableIntStateOf(0) }
+
+    // Track-change stretch. The first composition is not a change, so it is skipped.
+    var lastTrackKey by remember { mutableStateOf(trackKey) }
+    LaunchedEffect(trackKey) {
+        if (trackKey != lastTrackKey) {
+            lastTrackKey = trackKey
+            skipCount++
+        }
+    }
+
+    LaunchedEffect(skipCount) {
+        if (skipCount > 0) width.playSkipStretch()
+    }
+
+    Row(
+        modifier = modifier,
+        horizontalArrangement = Arrangement.spacedBy(PlaybackSpec.Gap, Alignment.CenterHorizontally),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        SideButton(
+            icon = Icons.Rounded.SkipPrevious,
+            description = stringResource(R.string.previous),
+            onClick = {
+                skipCount++
+                onPrevious()
+            },
+            onLongClick = onLongPressPrevious,
+            onLongClickEnd = onLongPressEnd,
+        )
+
+        val containerColor =
+            if (playing) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.secondaryContainer
+        val contentColor =
+            if (playing) MaterialTheme.colorScheme.onPrimary else MaterialTheme.colorScheme.onSecondaryContainer
+
+        Surface(
+            modifier =
+                Modifier
+                    .width(width.value.dp)
+                    .height(PlaybackSpec.HeightDp)
+                    .pointerInput(Unit) {
+                        detectTapGestures(
+                            onPress = {
+                                scope.launch {
+                                    width.animateTo(
+                                        PlaybackSpec.PressWidth,
+                                        tween(PlaybackSpec.PRESS_MS, easing = PlaybackSpec.PressEase),
+                                    )
+                                }
+                                val released = tryAwaitRelease()
+                                scope.launch {
+                                    width.animateTo(PlaybackSpec.ReleaseWidth, PlaybackSpec.ReboundSpring)
+                                    width.animateTo(PlaybackSpec.RestWidth, PlaybackSpec.SettleSpring)
+                                }
+                                if (released) {
+                                    playing = !playing
+                                    onPlayPauseChange(playing)
+                                }
+                            },
+                        )
+                    },
+            shape = RoundedCornerShape(percent = 50),
+            color = containerColor,
+            contentColor = contentColor,
+        ) {
+            Box(contentAlignment = Alignment.Center, modifier = Modifier.fillMaxSize()) {
+                AnimatedContent(
+                    targetState = playing,
+                    transitionSpec = {
+                        (fadeIn(tween(120)) + scaleIn(initialScale = 0.7f)) togetherWith
+                            (fadeOut(tween(120)) + scaleOut(targetScale = 0.7f))
+                    },
+                    label = "playPauseMorph",
+                ) { isPlayingNow ->
+                    Icon(
+                        imageVector = if (isPlayingNow) Icons.Rounded.Pause else Icons.Rounded.PlayArrow,
+                        contentDescription = null,
+                        tint = contentColor,
+                        modifier = Modifier.size(PlaybackSpec.HeightDp * 0.5f),
+                    )
+                }
+            }
+        }
+
+        SideButton(
+            icon = Icons.Rounded.SkipNext,
+            description = stringResource(R.string.next),
+            onClick = {
+                skipCount++
+                onNext()
+            },
+            onLongClick = onLongPressNext,
+            onLongClickEnd = onLongPressEnd,
+        )
+    }
+}
+
+/**
+ * Phases 1-4 of the Previous/Next stretch, with the timings from the recording:
+ * 0-117 ms expand to 300 px, 117-234 ms hold, 234-370 ms recoil to 266 px, 370-520 ms settle to 270 px.
+ */
+private suspend fun Animatable<Float, AnimationVector1D>.playSkipStretch() {
+    animateTo(
+        PlaybackSpec.PeakWidth,
+        tween(PlaybackSpec.EXPAND_MS, easing = PlaybackSpec.StiffSnap),
+    )
+    delay(PlaybackSpec.HOLD_MS.toLong())
+    animateTo(
+        PlaybackSpec.UndershootWidth,
+        tween(PlaybackSpec.RECOIL_MS, easing = PlaybackSpec.RecoilEase),
+    )
+    animateTo(PlaybackSpec.RestWidth, PlaybackSpec.SettleSpring)
+}
+
+@Composable
+private fun SideButton(
+    icon: ImageVector,
+    description: String,
+    onClick: () -> Unit,
+    onLongClick: (() -> Unit)?,
+    onLongClickEnd: (() -> Unit)?,
+) {
+    val interaction = remember { MutableInteractionSource() }
+    val pressed by interaction.collectIsPressedAsState()
+    LaunchedEffect(pressed) {
+        if (!pressed) onLongClickEnd?.invoke()
+    }
+
+    Box(
+        modifier =
+            Modifier
+                .size(width = PlaybackSpec.SideWidth, height = PlaybackSpec.SideHeight)
+                .clip(RoundedCornerShape(PlaybackSpec.SideCorner))
+                .background(MaterialTheme.colorScheme.secondaryContainer)
+                .combinedClickable(
+                    interactionSource = interaction,
+                    indication = ripple(color = MaterialTheme.colorScheme.onSecondaryContainer),
+                    onClick = onClick,
+                    onLongClick = onLongClick,
+                ),
+        contentAlignment = Alignment.Center,
+    ) {
+        Icon(
+            imageVector = icon,
+            contentDescription = description,
+            tint = MaterialTheme.colorScheme.onSecondaryContainer,
+            modifier = Modifier.size(PlaybackSpec.SideHeight * 0.5f),
+        )
+    }
+}
+
+/** Standalone preview: 0C100F background, both behaviours wired to buttons for testing. */
+@Composable
+fun MusicPlaybackControlsDemo() {
+    var playing by remember { mutableStateOf(true) }
+    var track by remember { mutableIntStateOf(0) }
+    Box(
+        modifier = Modifier.fillMaxSize().background(Color(0xFF0C100F)),
+        contentAlignment = Alignment.Center,
+    ) {
+        MusicPlaybackControls(
+            isPlaying = playing,
+            trackKey = track,
+            onPrevious = { track-- },
+            onNext = { track++ },
+            onPlayPauseChange = { playing = it },
+        )
+    }
+}
