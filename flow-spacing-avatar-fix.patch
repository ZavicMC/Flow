+/**
+ * Sizes are measured from the reference screenshot (720 px wide, 2 px per dp). The centre pill
+ * rests at 136 dp. Its motion is a width ratio (1.0 = rest), taken from the 40 frames of the
+ * Mornye recording at 51 fps, one frame ≈ 19.6 ms.
+ */
+internal object PlaybackSpec {
+    val SideWidth: Dp = 89.5f.dp
+    val SideHeight: Dp = 69f.dp
+    val SideCorner: Dp = 24.dp
+    val Gap: Dp = 8.dp
+    val HeightDp: Dp = 69f.dp
+    val RestWidth: Dp = 136f.dp
+
+    // Frames 1–6: press down. Width ratio 1.0 → 0.896 in 98 ms. The right edge stays put.
+    val PressKeyframes = keyframes<Float> {
+        durationMillis = 98
+        0.978f at 20 using LinearEasing
+        0.948f at 39 using LinearEasing
+        0.918f at 59 using LinearEasing
+        0.903f at 78 using LinearEasing
+        0.896f at 98 using LinearEasing
+    }
+
+    // Frames 15–31: release. Stretch to 1.167 by 118 ms, then ease back to rest by 314 ms.
+    val ReleaseKeyframes = keyframes<Float> {
+        durationMillis = 314
+        1.004f at 20 using LinearEasing
+        1.045f at 39 using LinearEasing
+        1.093f at 59 using LinearEasing
+        1.138f at 78 using LinearEasing
+        1.164f at 98 using LinearEasing
+        1.167f at 118 using LinearEasing
+        1.108f at 137 using LinearEasing
+        1.0f at 314 using FastOutSlowInEasing
+    }
+
+    // Frames 31–38: previous/next. Hold, then shrink to 0.892 by 118 ms and hold.
+    val SkipKeyframes = keyframes<Float> {
+        durationMillis = 137
+        1.0f at 39 using LinearEasing
+        0.966f at 59 using LinearEasing
+        0.937f at 78 using LinearEasing
+        0.907f at 98 using LinearEasing
+        0.892f at 118 using LinearEasing
+        0.892f at 137 using LinearEasing
+    }
+
+    val SettleSpring = spring<Float>(dampingRatio = 0.68f, stiffness = 380f)
+
+    // Side buttons keep Mornye's swell and light from mornye_glass_press.dart.
+    val GlassPressSpring = spring<Float>(dampingRatio = 0.585f, stiffness = 420f)
+    const val SWELL_FRACTION = 0.10f
+    const val SWELL_MIN_DP = 2f
+    const val SWELL_MAX_DP = 5f
+    const val LIGHT_ALPHA = 0.20f
+    const val LIGHT_REACH_MIN_DP = 40f
+    const val LIGHT_REACH_MAX_DP = 180f
+}
+
+/**
+ * Previous, Play/Pause and Next.
+ *
+ * - Pressing the centre pill compresses it (frames 1–6). Releasing toggles play/pause and
+ *   stretches it back to rest (frames 15–31).
+ * - Previous and Next shrink the pill (frames 31–38). While [isLoading] is true, the pill shows
+ *   the loading state (frames 7–14 and 39–40) in the surface colour with a spinner.
+ */
+@Composable
+fun MusicPlaybackControls(
+    isPlaying: Boolean,
+    onPrevious: () -> Unit,
+    onNext: () -> Unit,
+    onPlayPauseChange: (Boolean) -> Unit,
+    modifier: Modifier = Modifier,
+    isLoading: Boolean = false,
+    onLongPressPrevious: (() -> Unit)? = null,
+    onLongPressNext: (() -> Unit)? = null,
+    onLongPressEnd: (() -> Unit)? = null,
+) {
+    val scope = rememberCoroutineScope()
+    val pillScale = remember { Animatable(1f) }
+    var playing by remember(isPlaying) { mutableStateOf(isPlaying) }
+
+    Row(
+        modifier = modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(PlaybackSpec.Gap, Alignment.CenterHorizontally),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        SideButton(
+            icon = Icons.Rounded.SkipPrevious,
+            description = stringResource(R.string.previous),
+            onClick = {
+                scope.launch {
+                    pillScale.animateTo(0.892f, PlaybackSpec.SkipKeyframes)
+                    pillScale.animateTo(1f, PlaybackSpec.SettleSpring)
+                }
+                onPrevious()
+            },
+            onLongClick = onLongPressPrevious,
+            onRelease = onLongPressEnd,
+        )
+
+        val pillColor = when {
+            isLoading -> MaterialTheme.colorScheme.surfaceContainerHigh
+            playing -> MaterialTheme.colorScheme.primary
+            else -> MaterialTheme.colorScheme.secondaryContainer
+        }
+        val contentColor = when {
+            isLoading -> MaterialTheme.colorScheme.onSurfaceVariant
+            playing -> MaterialTheme.colorScheme.onPrimary
+            else -> MaterialTheme.colorScheme.onSecondaryContainer
+        }
+
+        Box(
+            modifier = Modifier
+                .width(PlaybackSpec.RestWidth * pillScale.value)
+                .height(PlaybackSpec.HeightDp)
+                .clip(RoundedCornerShape(percent = 50))
+                .background(pillColor)
+                .pointerInput(Unit) {
+                    detectTapGestures(
+                        onPress = {
+                            scope.launch { pillScale.animateTo(0.896f, PlaybackSpec.PressKeyframes) }
+                            val released = tryAwaitRelease()
+                            scope.launch {
+                                pillScale.snapTo(1.0f)
+                                pillScale.animateTo(1.0f, PlaybackSpec.ReleaseKeyframes)
+                            }
+                            if (released) {
+                                playing = !playing
+                                onPlayPauseChange(playing)
+                            }
+                        },
+                    )
+                },
+            contentAlignment = Alignment.Center,
+        ) {
+            if (isLoading) {
+                CircularProgressIndicator(
+                    modifier = Modifier.size(PlaybackSpec.HeightDp * 0.4f),
+                    color = contentColor,
+                    strokeWidth = 3.dp,
+                )
+            } else {
+                AnimatedContent(
+                    targetState = playing,
+                    transitionSpec = {
+                        (fadeIn(tween(120)) + scaleIn(initialScale = 0.7f)) togetherWith
+                            (fadeOut(tween(120)) + scaleOut(targetScale = 0.7f))
+                    },
+                    label = "playPauseMorph",
+                ) { isPlayingNow ->
+                    Icon(
+                        imageVector = if (isPlayingNow) Icons.Rounded.Pause else Icons.Rounded.PlayArrow,
+                        contentDescription = null,
+                        tint = contentColor,
+                        modifier = Modifier.size(PlaybackSpec.HeightDp * 0.5f),
+                    )
+                }
+            }
+        }
+
+        SideButton(
+            icon = Icons.Rounded.SkipNext,
+            description = stringResource(R.string.next),
+            onClick = {
+                scope.launch {
+                    pillScale.animateTo(0.892f, PlaybackSpec.SkipKeyframes)
+                    pillScale.animateTo(1f, PlaybackSpec.SettleSpring)
+                }
+                onNext()
+            },
+            onLongClick = onLongPressNext,
+            onRelease = onLongPressEnd,
+        )
+    }
+}
+
+@Composable
+private fun SideButton(
+    icon: ImageVector,
+    description: String,
+    onClick: () -> Unit,
+    onLongClick: (() -> Unit)?,
+    onRelease: (() -> Unit)?,
+) {
+    GlassPressBox(
+        modifier = Modifier.size(width = PlaybackSpec.SideWidth, height = PlaybackSpec.SideHeight),
+        shape = RoundedCornerShape(PlaybackSpec.SideCorner),
+        cornerRadius = PlaybackSpec.SideCorner,
+        containerColor = MaterialTheme.colorScheme.secondaryContainer,
+        onClick = onClick,
+        onLongClick = onLongClick,
+        onRelease = onRelease,
+    ) {
+        Icon(
+            imageVector = icon,
+            contentDescription = description,
+            tint = MaterialTheme.colorScheme.onSecondaryContainer,
+            modifier = Modifier.size(PlaybackSpec.SideHeight * 0.5f),
+        )
+    }
+}
+
+/** Mornye's glass press (swell and light) for the side buttons. Layout and hit target stay fixed. */
+@Composable
+private fun GlassPressBox(
+    modifier: Modifier,
+    shape: Shape,
+    cornerRadius: Dp,
+    containerColor: Color,
+    onClick: () -> Unit,
+    onLongClick: (() -> Unit)?,
+    onRelease: (() -> Unit)?,
+    content: @Composable BoxScope.() -> Unit,
+) {
+    val density = LocalDensity.current.density
+    val press = remember { Animatable(0f) }
+    val pointer = remember { mutableStateOf<Offset?>(null) }
+    val boxSize = remember { mutableStateOf(IntSize.Zero) }
+    val scope = rememberCoroutineScope()
+    val releaseCallback by rememberUpdatedState(onRelease)
+    val interaction = remember { MutableInteractionSource() }
+
+    Box(
+        modifier = modifier
+            .graphicsLayer {
+                val w = boxSize.value.width.toFloat()
+                val h = boxSize.value.height.toFloat()
+                val p = press.value
+                if (w > 0f && h > 0f && p != 0f) {
+                    val swellDp = (min(w, h) / density * PlaybackSpec.SWELL_FRACTION)
+                        .coerceIn(PlaybackSpec.SWELL_MIN_DP, PlaybackSpec.SWELL_MAX_DP) * p
+                    val swellPx = swellDp * density
+                    scaleX = 1f + swellPx / w
+                    scaleY = 1f + swellPx / h
+                }
+            }
+            .clip(shape)
+            .background(containerColor)
+            .onSizeChanged { boxSize.value = it }
+            .pointerInput(Unit) {
+                awaitEachGesture {
+                    val down = awaitFirstDown(requireUnconsumed = false)
+                    pointer.value = down.position
+                    scope.launch { press.animateTo(1f, PlaybackSpec.GlassPressSpring) }
+                    waitForUpOrCancellation()
+                    scope.launch { press.animateTo(0f, PlaybackSpec.GlassPressSpring) }
+                    releaseCallback?.invoke()
+                }
+            }
+            .combinedClickable(
+                interactionSource = interaction,
+                indication = null,
+                onClick = onClick,
+                onLongClick = onLongClick,
+            )
+            .drawWithContent {
+                drawContent()
+                val p = press.value.coerceIn(0f, 1f)
+                if (p > 0f) {
+                    val focus = pointer.value ?: Offset(size.width / 2f, size.height / 2f)
+                    val reach = size.maxDimension.coerceIn(
+                        PlaybackSpec.LIGHT_REACH_MIN_DP * density,
+                        PlaybackSpec.LIGHT_REACH_MAX_DP * density,
+                    )
+                    drawRoundRect(
+                        brush = Brush.radialGradient(
+                            colors = listOf(
+                                Color.White.copy(alpha = PlaybackSpec.LIGHT_ALPHA * p),
+                                Color.White.copy(alpha = 0f),
+                            ),
+                            center = focus,
+                            radius = reach,
+                        ),
+                        cornerRadius = CornerRadius(cornerRadius.toPx()),
+                    )
+                }
+            },
+        contentAlignment = Alignment.Center,
+        content = content,
+    )
+}
