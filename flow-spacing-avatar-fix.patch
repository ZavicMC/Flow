+
+/** Geometry and motion constants from the spec. */
+object MusicTransportSpec {
+    val Height: Dp = 64.dp
+    val Gap: Dp = 16.dp
+    const val SIDE_ASPECT_RATIO = 1.25f // width : height
+    val SideCorner: Dp = 26.dp // within the 24–28 dp squircle range
+    const val CENTER_WIDTH_MULTIPLIER = 1.6f // relative to a side button's width
+    const val STRETCH_SCALE = 1.17f
+    const val PRESS_SCALE = 0.92f
+    const val DAMPING_RATIO = 0.7f
+    const val STIFFNESS_STRETCH = 1500f
+    const val STIFFNESS_RECOIL = 400f
+}
+
+/**
+ * Previous, play/pause and next controls for the music player.
+ *
+ * Usage: pass the same callbacks the old MediaPlaybackControls received.
+ * [skipTrigger] is a counter the caller increments whenever the track changes, which drives the
+ * elastic stretch of the centre pill; a stretch also fires on a local Previous/Next tap.
+ */
+@Composable
+fun MusicTransportBar(
+    isPlaying: Boolean,
+    onPreviousClick: () -> Unit,
+    onPlayPauseToggle: () -> Unit,
+    onNextClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    skipTrigger: Int = 0,
+    onLongPressPrevious: (() -> Unit)? = null,
+    onLongPressNext: (() -> Unit)? = null,
+    onLongPressEnd: (() -> Unit)? = null,
+) {
+    val sideWidth = MusicTransportSpec.Height * MusicTransportSpec.SIDE_ASPECT_RATIO
+    val centerWidth = sideWidth * MusicTransportSpec.CENTER_WIDTH_MULTIPLIER
+
+    var localSkips by remember { mutableIntStateOf(0) }
+    val stretch = remember { Animatable(1f) }
+    val pressSquish = remember { Animatable(1f) }
+
+    val playPauseInteraction = remember { MutableInteractionSource() }
+    val isCenterPressed by playPauseInteraction.collectIsPressedAsState()
+
+    // Elastic stretch: snap wide quickly, then recoil with a damped spring that settles at 1.0x.
+    val totalSkips = skipTrigger + localSkips
+    LaunchedEffect(totalSkips) {
+        if (totalSkips == 0) return@LaunchedEffect
+        stretch.animateTo(
+            MusicTransportSpec.STRETCH_SCALE,
+            spring(
+                dampingRatio = MusicTransportSpec.DAMPING_RATIO,
+                stiffness = MusicTransportSpec.STIFFNESS_STRETCH,
+            ),
+        )
+        stretch.animateTo(
+            1f,
+            spring(
+                dampingRatio = MusicTransportSpec.DAMPING_RATIO,
+                stiffness = MusicTransportSpec.STIFFNESS_RECOIL,
+            ),
+        )
+    }
+
+    LaunchedEffect(isCenterPressed) {
+        pressSquish.animateTo(
+            if (isCenterPressed) MusicTransportSpec.PRESS_SCALE else 1f,
+            spring(dampingRatio = 0.6f, stiffness = 600f),
+        )
+    }
+
+    Row(
+        modifier = modifier.fillMaxWidth().height(MusicTransportSpec.Height),
+        horizontalArrangement = Arrangement.spacedBy(MusicTransportSpec.Gap, Alignment.CenterHorizontally),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        SideButton(
+            icon = Icons.Rounded.SkipPrevious,
+            contentDescription = stringResource(R.string.previous),
+            width = sideWidth,
+            onClick = {
+                localSkips++
+                onPreviousClick()
+            },
+            onLongClick = onLongPressPrevious,
+            onLongClickEnd = onLongPressEnd,
+        )
+
+        Box(
+            modifier =
+                Modifier
+                    .width(centerWidth)
+                    .height(MusicTransportSpec.Height)
+                    .graphicsLayer {
+                        scaleX = stretch.value * pressSquish.value
+                        scaleY = pressSquish.value
+                    }
+                    .clip(RoundedCornerShape(9999.dp))
+                    .background(MaterialTheme.colorScheme.primary)
+                    .combinedClickable(
+                        interactionSource = playPauseInteraction,
+                        indication = ripple(color = MaterialTheme.colorScheme.onPrimary),
+                        onClick = onPlayPauseToggle,
+                        onClickLabel = stringResource(if (isPlaying) R.string.pause else R.string.play),
+                    ),
+            contentAlignment = Alignment.Center,
+        ) {
+            AnimatedContent(
+                targetState = isPlaying,
+                transitionSpec = {
+                    (fadeIn(spring(stiffness = 800f)) + scaleIn(initialScale = 0.7f)) togetherWith
+                        (fadeOut(spring(stiffness = 800f)) + scaleOut(targetScale = 0.7f))
+                },
+                label = "playPauseIcon",
+            ) { playing ->
+                Icon(
+                    imageVector = if (playing) Icons.Rounded.Pause else Icons.Rounded.PlayArrow,
+                    contentDescription = null,
+                    tint = MaterialTheme.colorScheme.onPrimary,
+                    modifier = Modifier.size(36.dp),
+                )
+            }
+        }
+
+        SideButton(
+            icon = Icons.Rounded.SkipNext,
+            contentDescription = stringResource(R.string.next),
+            width = sideWidth,
+            onClick = {
+                localSkips++
+                onNextClick()
+            },
+            onLongClick = onLongPressNext,
+            onLongClickEnd = onLongPressEnd,
+        )
+    }
+}
+
+@Composable
+private fun SideButton(
+    icon: ImageVector,
+    contentDescription: String,
+    width: Dp,
+    onClick: () -> Unit,
+    onLongClick: (() -> Unit)?,
+    onLongClickEnd: (() -> Unit)?,
+) {
+    val interaction = remember { MutableInteractionSource() }
+    val pressed by interaction.collectIsPressedAsState()
+    val squish = remember { Animatable(1f) }
+    LaunchedEffect(pressed) {
+        squish.animateTo(
+            if (pressed) MusicTransportSpec.PRESS_SCALE else 1f,
+            spring(dampingRatio = 0.6f, stiffness = 600f),
+        )
+        // Releasing the finger ends a long-press preview. Harmless on a plain tap.
+        if (!pressed) onLongClickEnd?.invoke()
+    }
+
+    Box(
+        modifier =
+            Modifier
+                .width(width)
+                .height(MusicTransportSpec.Height)
+                .graphicsLayer {
+                    scaleX = squish.value
+                    scaleY = squish.value
+                }
+                .clip(RoundedCornerShape(MusicTransportSpec.SideCorner))
+                .background(MaterialTheme.colorScheme.secondaryContainer)
+                .combinedClickable(
+                    interactionSource = interaction,
+                    indication = ripple(color = MaterialTheme.colorScheme.onSecondaryContainer),
+                    onClick = onClick,
+                    onLongClick = onLongClick,
+                ),
+        contentAlignment = Alignment.Center,
+    ) {
+        Icon(
+            imageVector = icon,
+            contentDescription = contentDescription,
+            tint = MaterialTheme.colorScheme.onSecondaryContainer,
+            modifier = Modifier.size(32.dp),
+        )
+    }
+}
